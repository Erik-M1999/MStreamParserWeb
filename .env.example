# Root env for the one-command Docker start (`docker compose up`).
# Copy to ".env" (gitignored) and fill in the values.
#
# The database URL and local DB credentials are already wired into
# docker-compose.yml — you only need the secrets below.
#
# (For non-Docker local dev, use backend/.env instead — see backend/.env.example.)

# --- Required: the app is unusable without these ---------------------------
# Signs login JWTs.            e.g. `openssl rand -hex 32`
JWT_SECRET=
# Encrypts stored Spotify tokens (AES-256-GCM).  e.g. `openssl rand -hex 32`
TOKEN_ENC_KEY=

# --- Optional integrations: the app runs fine without them -----------------
# Spotify OAuth (https://developer.spotify.com/dashboard). Register the redirect
# URI http://127.0.0.1:3000/api/auth/spotify/callback in your Spotify app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm app API key (https://www.last.fm/api/account/create).
LASTFM_API_KEY=

# Welcome email on register (https://resend.com). MAIL_FROM must be a
# Resend-verified sender. Leave blank to disable email.
RESEND_API_KEY=
MAIL_FROM=
