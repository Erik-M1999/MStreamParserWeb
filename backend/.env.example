# Copy this file to ".env" and fill in your real values.
# ".env" is gitignored and must NEVER be committed.
#
# LOCAL DEV: the backend loads this .env (npm run dev/start use --env-file).
# PRODUCTION (Hetzner/konsoleH): do NOT upload .env — set each of these as
# environment variables in the konsoleH Node.js config UI instead.

# --- Runtime -------------------------------------------------------------
# "production" on the server (enables secure cookies, disables /spotify/debug).
# Leave unset locally.
NODE_ENV=development

# PORT is provided by the hosting platform (konsoleH) — do NOT set it in prod.
# Locally the backend falls back to 3000.

# --- Database (Prisma → MySQL/MariaDB) -----------------------------------
# Local dev uses the Docker MariaDB from docker-compose.yml (run: docker compose up -d).
# Production uses the konsoleH MySQL database (its own user/password/host).
DATABASE_URL="mysql://msp:msp_local_dev@127.0.0.1:3306/MStreamParserWeb"

# --- Auth ----------------------------------------------------------------
# Signs login JWTs. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-secret

# Encrypts stored Spotify tokens at rest (AES-256-GCM). Any long random string
# (e.g. `openssl rand -hex 32`). Changing it just forces users to reconnect.
TOKEN_ENC_KEY=replace-with-a-long-random-secret

# --- Spotify OAuth (https://developer.spotify.com/dashboard) --------------
SPOTIFY_CLIENT_ID=your-client-id-here
SPOTIFY_CLIENT_SECRET=your-client-secret-here

# Must EXACTLY match a Redirect URI registered in your Spotify app.
#   local: http://127.0.0.1:3000/api/auth/spotify/callback
#   prod:  https://m1999-tools.de/api/auth/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# --- Last.fm (https://www.last.fm/api/account/create) --------------------
# Read-only: only the app API key is needed; users "connect" with their Last.fm
# username (no OAuth, no per-user secret).
LASTFM_API_KEY=your-lastfm-api-key-here

# --- App origin ----------------------------------------------------------
# Where the backend redirects the browser after Spotify OAuth (and the login
# link in emails). In the single-app deploy this is the app's own domain.
#   local: http://127.0.0.1:5173
#   prod:  https://m1999-tools.de
FRONTEND_ORIGIN=http://127.0.0.1:5173

# --- Email (Resend, https://resend.com) — optional -----------------------
# Welcome email on register. If unset, email is skipped (the app still works).
# MAIL_FROM must be an address on a domain you've VERIFIED in Resend.
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=MStreamParserWeb <noreply@yourdomain.example>
