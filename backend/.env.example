# Copy this file to ".env" and fill in your real values.
# ".env" is gitignored and must NEVER be committed.
# On deploy (Hetzner/konsoleH), set these as environment variables in the
# platform's Node.js config UI instead of uploading a .env file.

# --- Spotify OAuth (from https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=your-client-id-here
SPOTIFY_CLIENT_SECRET=your-client-secret-here

# Must EXACTLY match the Redirect URI registered in your Spotify app settings.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# Where the backend sends the user back to after a successful login.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# --- Database (Prisma) ---
# Local dev uses a hardcoded SQLite file (prisma/schema.prisma) and IGNORES this
# variable, so a not-yet-ready MySQL URL here is harmless. Only uncomment + use
# it at Session 10 when switching the schema's provider to "mysql".
# DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DBNAME"

# --- Auth ---
# Used to sign login JWTs. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-secret

# Used to encrypt stored Spotify tokens at rest (AES-256-GCM). Any long random
# string works (e.g. `openssl rand -hex 32`). Changing it makes already-stored
# tokens undecryptable — users would just reconnect Spotify.
TOKEN_ENC_KEY=replace-with-a-long-random-secret
