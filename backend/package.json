{
  "name": "mstreamparser-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express backend for MStreamParserWeb. Serves read-only dashboard data.",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "watch": "tsc --watch",
    "dev": "node --watch --env-file-if-exists=.env dist/server.js",
    "seed": "tsc && node --env-file-if-exists=.env dist/scripts/seed.js",
    "db:reset": "tsc && prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env dist/scripts/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@xmldom/xmldom": "0.9.10",
    "bcrypt": "6.0.0",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.2",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
