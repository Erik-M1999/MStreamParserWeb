{
  "name": "mstreamparser-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express backend for MStreamParserWeb. Serves read-only dashboard data.",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "watch": "tsc --watch",
    "dev": "node --watch --env-file-if-exists=.env dist/server.js",
    "seed": "tsc && node --env-file-if-exists=.env dist/scripts/seed.js",
    "migrate:tokens": "tsc && node --env-file-if-exists=.env dist/scripts/migrate-token-encryption.js",
    "db:reset": "tsc && prisma migrate reset --force",
    "build:web": "npm --prefix ../frontend run build && node -e \"const fs=require('fs');fs.rmSync('public',{recursive:true,force:true});fs.cpSync('../frontend/out','public',{recursive:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env dist/scripts/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.9",
    "@resvg/resvg-js": "2.6.2",
    "@xmldom/xmldom": "0.9.10",
    "bcrypt": "6.0.0",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "6.16.0"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.9",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
