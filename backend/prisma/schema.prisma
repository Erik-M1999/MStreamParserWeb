// MySQL/MariaDB for both local dev (Docker, see docker-compose.yml) and prod
// (Hetzner konsoleH). The connection string comes from DATABASE_URL:
//   local: mysql://msp:msp_local_dev@127.0.0.1:3306/MStreamParserWeb
//   prod:  set as a server env var in konsoleH (never committed)
// Note the @db.Text fields below: MySQL's default String is VARCHAR(191), too
// small for SVG bodies and encrypted tokens — so those are widened explicitly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  folders     Folder[]
  templates   Template[]
  connections Connection[]
  apiKeys     ApiKey[]
}

model Folder {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  parentId  Int?
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  templates Template[]
  createdAt DateTime @default(now())
}

model Template {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  svg       String   @db.MediumText // full SVG document — far exceeds VARCHAR(191)
  mode      String
  folderId  Int?
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Connection {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  accessToken  String   @db.Text // AES-encrypted token — longer than VARCHAR(191)
  refreshToken String   @db.Text // AES-encrypted token — longer than VARCHAR(191)
  expiresAt    DateTime
  scopes       String   @db.Text // space-separated scope list — headroom to grow
  // For token-less providers (e.g. Last.fm) this holds the account name/username;
  // OAuth providers (Spotify) leave it null and use the token columns above.
  accountName  String?
  createdAt    DateTime @default(now())

  @@unique([userId, provider])
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}
